new file mode 100644
index 0000000000..b02c099a8c
--- /dev/null
+++ b/agent/conversation_policy.py
@@ -0,0 +1,56 @@
+"""Process-selected, agent-bound conversation capability policy.
+
+The ContextVar carries the immutable restriction across construction and execution;
+agent.policy is the durable session binding. Neither toolset names nor client RPC
+parameters can turn this policy off.
+"""
+from contextlib import contextmanager
+from contextvars import ContextVar
+from dataclasses import dataclass
+
+
+@dataclass(frozen=True)
+class ConversationPolicy:
+    mode: str = "conversation-only"
+    version: int = 1
+
+    def metadata(self, session_id: str) -> dict:
+        return {"version": self.version, "mode": self.mode, "sessionId": session_id,
+                "tools": [], "memory": False, "contextFiles": False,
+                "plugins": False, "modelingWrites": False}
+
+
+CONVERSATION_ONLY = ConversationPolicy()
+DIRECT_INFERENCE_MODES = frozenset({"chat_completions", "codex_responses", "anthropic_messages", "bedrock_converse"})
+_active_policy: ContextVar[ConversationPolicy | None] = ContextVar("conversation_policy", default=None)
+
+
+def current_policy() -> ConversationPolicy | None:
+    return _active_policy.get()
+
+
+@contextmanager
+def policy_scope(policy: ConversationPolicy | None):
+    token = _active_policy.set(policy)
+    try:
+        yield
+    finally:
+        _active_policy.reset(token)
+
+
+def require_policy(agent, expected: ConversationPolicy):
+    """Fail closed if an agent or its tool snapshot drifted from its session policy."""
+    if getattr(agent, "conversation_policy", None) != expected:
+        raise PermissionError("Conversation policy mismatch")
+    if expected is not None:
+        require_direct_inference(agent)
+    if expected is not None and (agent.tools != [] or agent.valid_tool_names != set()
+                                 or agent._memory_manager is not None or agent._memory_store is not None
+                                 or not agent.skip_context_files or not agent.skip_background_review):
+        raise PermissionError("Conversation-only agent capabilities changed")
+
+
+def require_direct_inference(agent):
+    """Nested agent runtimes have their own tools and cannot inherit this boundary."""
+    if getattr(agent, "api_mode", None) not in DIRECT_INFERENCE_MODES or getattr(agent, "provider", "") in {"copilot-acp", "moa"}:
+        raise PermissionError("Conversation-only mode requires a direct inference transport")
