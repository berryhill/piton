index 0000000000..c96d0d4655
--- /dev/null
+++ b/tests/acp_adapter/test_conversation_only.py
@@ -0,0 +1,123 @@
+"""Restricted ACP construction and dispatch invariants with real runtime imports."""
+import asyncio
+import json
+import threading
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from types import SimpleNamespace
+
+import pytest
+
+from acp_adapter.entry import _parse_args
+from acp_adapter.server import HermesACPAgent
+from acp_adapter.session import SessionManager
+from agent.conversation_policy import CONVERSATION_ONLY, current_policy
+
+
+def test_restricted_session_construction_and_dispatch(monkeypatch, tmp_path, request):
+    from hermes_cli import config, runtime_provider
+    from agent import prompt_builder, agent_init, system_prompt
+    from hermes_cli import plugins
+    from model_tools import handle_function_call
+    from tools.registry import registry
+    from agent.tool_executor import execute_tool_calls_sequential
+
+    assert _parse_args(["--conversation-only"]).conversation_only
+    assert not _parse_args([]).conversation_only
+    calls = []
+    class Provider(BaseHTTPRequestHandler):
+        def log_message(self, format, *args):
+            pass
+        def do_POST(self):
+            value = json.loads(self.rfile.read(int(self.headers['Content-Length'])))
+            calls.append(value)
+            payload = json.dumps({"id": "synthetic", "created": 0, "model": "test-model", "object": "chat.completion",
+                "choices": [{"index": 0, "finish_reason": "stop", "message": {"role": "assistant", "content": "synthetic reply"}}],
+                "usage": {"prompt_tokens": 1, "completion_tokens": 1, "total_tokens": 2}}).encode()
