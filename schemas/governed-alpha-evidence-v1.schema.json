{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "piton.governed-alpha-evidence.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "project_id", "revision_id", "build_attempt_id", "evidence_closure_digest", "framework_packet_closure_digest", "review_packet_digest", "exact_brep_digest", "exact_brep_claim_scope", "step_digest", "step_claim_scope", "review_glb_digest", "review_glb_claim_scope", "review_selection_map_digest", "review_selection_map_claim_scope", "review_state", "fabrication_release", "machine_actuation", "release_state", "channel_transition"],
  "properties": {
    "schema": {"const": "piton.governed-alpha-evidence.v1"},
    "project_id": {"$ref": "#/$defs/identifier"},
    "revision_id": {"type": "string", "pattern": "^rev_[0-9a-f]{64}$"},
    "build_attempt_id": {"$ref": "#/$defs/identifier"},
    "evidence_closure_digest": {"$ref": "#/$defs/digest"},
    "framework_packet_closure_digest": {"$ref": "#/$defs/digest"},
    "review_packet_digest": {"$ref": "#/$defs/digest"},
    "exact_brep_digest": {"$ref": "#/$defs/digest"},
    "exact_brep_claim_scope": {"const": "exact-realization"},
    "step_digest": {"$ref": "#/$defs/digest"},
    "step_claim_scope": {"const": "exact-exchange"},
    "review_glb_digest": {"$ref": "#/$defs/digest"},
    "review_glb_claim_scope": {"const": "review-only"},
    "review_selection_map_digest": {"$ref": "#/$defs/digest"},
    "review_selection_map_claim_scope": {"const": "review-only"},
    "review_state": {"const": "needs_human_review"},
    "fabrication_release": {"const": false},
    "machine_actuation": {"const": false},
    "release_state": {"const": "unreleased"},
    "channel_transition": {"const": false}
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 256},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
