{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "piton.design-revision.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "revision_id",
    "parent_revision_id",
    "authority_profile",
    "source_manifest_digest",
    "entrypoint",
    "dependency_lock_digest",
    "toolchain_lock_digest",
    "parameter_values"
  ],
  "properties": {
    "schema": {"const": "piton.design-revision.v1"},
    "revision_id": {
      "type": "string",
      "pattern": "^rev_[0-9a-f]{64}$"
    },
    "parent_revision_id": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^rev_[0-9a-f]{64}$"}
      ]
    },
    "authority_profile": {"const": "source-native/v0"},
    "source_manifest_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "entrypoint": {"type": "string", "minLength": 1},
    "dependency_lock_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "toolchain_lock_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "parameter_values": {
      "type": "object",
      "propertyNames": {"minLength": 1},
      "additionalProperties": {"type": "string"}
    },
    "proposal_id": {"type": "string", "minLength": 1}
  }
}
