{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "piton.restore-forward-request.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "request_digest", "operation", "project_id", "accepted_project_digest", "candidate_project_digest", "history_rewrite", "accepted_state_mutation", "claim_scope", "claim_scope_exclusions", "safety"],
  "properties": {
    "schema": {"const": "piton.restore-forward-request.v1"},
    "request_digest": {"$ref": "#/$defs/digest"},
    "operation": {"const": "restore_forward_new_revision"},
    "project_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"},
    "accepted_project_digest": {"$ref": "#/$defs/digest"},
    "candidate_project_digest": {"$ref": "#/$defs/digest"},
    "history_rewrite": {"const": false},
    "accepted_state_mutation": {"const": false},
    "claim_scope": {"const": "human_review_request_only"},
    "claim_scope_exclusions": {"const": ["acceptance", "approval", "history_rewrite", "fabrication_release", "machine_actuation"]},
    "safety": {"$ref": "#/$defs/safety"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "safety": {
      "type": "object", "additionalProperties": false,
      "required": ["review_state", "fabrication_release", "machine_actuation"],
      "properties": {
        "review_state": {"const": "needs_human_review"},
        "fabrication_release": {"const": false},
        "machine_actuation": {"const": false}
      }
    }
  }
}
