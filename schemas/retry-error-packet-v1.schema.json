{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "piton.retry-error-packet.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attempt",
    "failed_step",
    "head_sha",
    "commands",
    "exit_codes",
    "failed_checks",
    "diagnosis",
    "changed_files",
    "next_fix",
    "evidence_refs",
    "sanitized_logs",
    "terminal_blockers"
  ],
  "properties": {
    "attempt": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "failed_step": {
      "type": "string",
      "minLength": 1
    },
    "head_sha": {
      "type": [
        "string",
        "null"
      ]
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "exit_codes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer"
      }
    },
    "failed_checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "diagnosis": {
      "type": "string",
      "minLength": 1
    },
    "changed_files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_fix": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sanitized_logs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "terminal_blockers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
