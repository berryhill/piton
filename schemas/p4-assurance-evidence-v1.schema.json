{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "piton.p4-assurance-evidence.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "policy_digest", "evaluated_requirement_ids", "result", "review_state", "fabrication_release", "machine_actuation"],
  "properties": {
    "schema": {"const": "piton.p4-assurance-evidence.v1"},
    "policy_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "evaluated_requirement_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "result": {"enum": ["hold", "rework", "stop", "reject"]},
    "review_state": {"const": "needs_human_review"},
    "fabrication_release": {"const": false},
    "machine_actuation": {"const": false}
  }
}
