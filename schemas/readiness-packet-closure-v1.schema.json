{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "piton.readiness-packet-closure.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "candidate_commit",
    "readiness_campaign_digest",
    "run_count",
    "counters",
    "claim_scope",
    "review_state",
    "g2_accepted",
    "fabrication_release",
    "machine_actuation"
  ],
  "properties": {
    "schema": {"const": "piton.readiness-packet-closure.v1"},
    "candidate_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "readiness_campaign_digest": {"$ref": "#/$defs/digest"},
    "run_count": {"const": 1000},
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "critical_violations",
        "false_successes",
        "false_releases",
        "missing_referenced_artifacts",
        "stale_promotions",
        "duplicate_external_effects",
        "unauthorized_approvals_or_releases",
        "unauthorized_cross_project_reads"
      ],
      "properties": {
        "critical_violations": {"const": 0},
        "false_successes": {"const": 0},
        "false_releases": {"const": 0},
        "missing_referenced_artifacts": {"const": 0},
        "stale_promotions": {"const": 0},
        "duplicate_external_effects": {"const": 0},
        "unauthorized_approvals_or_releases": {"const": 0},
        "unauthorized_cross_project_reads": {"const": 0}
      }
    },
    "claim_scope": {"const": "readiness-evidence-only"},
    "review_state": {"const": "needs_human_review"},
    "g2_accepted": {"const": false},
    "fabrication_release": {"const": false},
    "machine_actuation": {"const": false}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
