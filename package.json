{
  "name": "piton",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "start": "./launch-piton.sh",
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit && pnpm typecheck:server",
    "typecheck:server": "tsc -p server/chat/tsconfig.json",
    "test": "vitest run && pnpm test:server",
    "test:server": "vitest run --config server/chat/vitest.config.ts",
    "test:e2e": "playwright test",
    "test:production": "playwright test --config playwright.production.config.ts",
    "build": "tsc --noEmit && vite build",
    "verify": "pnpm typecheck && pnpm test && pnpm build && pnpm test:e2e && pnpm test:production"
  },
  "dependencies": {
    "@sqlite.org/sqlite-wasm": "3.51.2-build8",
    "manifold-3d": "3.3.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "three": "0.183.2"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.183.1",
    "@types/node": "24.10.14",
    "@vitejs/plugin-react": "5.1.4",
    "jsdom": "28.1.0",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "4.0.18"
  }
}