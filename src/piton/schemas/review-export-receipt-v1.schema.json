{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "piton.review-export-receipt.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "receipt_digest", "project_id", "project_manifest_digest", "source_closure", "claim_scope", "claim_scope_exclusions", "release_state", "channel_transition", "source_executed", "safety"],
  "properties": {
    "schema": {"const": "piton.review-export-receipt.v1"},
    "receipt_digest": {"$ref": "#/$defs/digest"},
    "project_id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"},
    "project_manifest_digest": {"$ref": "#/$defs/digest"},
    "source_closure": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "digest"],
        "properties": {"path": {"type": "string", "minLength": 1}, "digest": {"$ref": "#/$defs/digest"}}
      }
    },
    "claim_scope": {"const": "review_only_reference_export"},
    "claim_scope_exclusions": {"const": ["approval", "fabrication_release", "machine_actuation", "channel_promotion"]},
    "release_state": {"const": "unreleased"},
    "channel_transition": {"const": false},
    "source_executed": {"const": false},
    "safety": {"$ref": "#/$defs/safety"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "safety": {
      "type": "object", "additionalProperties": false,
      "required": ["review_state", "fabrication_release", "machine_actuation"],
      "properties": {
        "review_state": {"const": "needs_human_review"},
        "fabrication_release": {"const": false},
        "machine_actuation": {"const": false}
      }
    }
  }
}
