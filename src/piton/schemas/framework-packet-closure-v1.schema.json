{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "piton.framework-packet-closure.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "closure_id", "project_id", "revision_id", "attempt_id", "evidence_closure_digest", "review_packet_digest", "worker_result_digest", "declaration_digest", "generation", "fence", "lease_id", "exact_brep_digest", "step_digest", "review_glb_digest", "review_selection_map_digest", "review_state", "fabrication_release", "machine_actuation", "release_state", "channel_transition"],
  "properties": {
    "schema": {"const": "piton.framework-packet-closure.v1"},
    "closure_id": {"$ref": "#/$defs/identifier"},
    "project_id": {"$ref": "#/$defs/identifier"},
    "revision_id": {"type": "string", "pattern": "^rev_[0-9a-f]{64}$"},
    "attempt_id": {"$ref": "#/$defs/identifier"},
    "evidence_closure_digest": {"$ref": "#/$defs/digest"},
    "review_packet_digest": {"$ref": "#/$defs/digest"},
    "worker_result_digest": {"$ref": "#/$defs/digest"},
    "declaration_digest": {"$ref": "#/$defs/digest"},
    "generation": {"type": "integer", "minimum": 0},
    "fence": {"type": "integer", "minimum": 0},
    "lease_id": {"$ref": "#/$defs/identifier"},
    "exact_brep_digest": {"$ref": "#/$defs/digest"},
    "step_digest": {"$ref": "#/$defs/digest"},
    "review_glb_digest": {"$ref": "#/$defs/digest"},
    "review_selection_map_digest": {"$ref": "#/$defs/digest"},
    "review_state": {"const": "needs_human_review"},
    "fabrication_release": {"const": false},
    "machine_actuation": {"const": false},
    "release_state": {"const": "unreleased"},
    "channel_transition": {"const": false}
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 256},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
