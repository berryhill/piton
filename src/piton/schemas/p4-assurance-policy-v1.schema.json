{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "piton.p4-assurance-policy.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "policy_id", "requirements", "supported_environment_ids", "e2e_required", "fault_runs_minimum", "critical_violations_maximum", "false_successes_maximum", "false_releases_maximum", "missing_referenced_blobs_maximum", "stale_promotions_maximum", "duplicate_effects_maximum", "unauthorized_cross_project_maximum", "a11y_serious_or_critical_maximum", "offline_golden_path", "backup_restore_verified", "review_state", "fabrication_release", "machine_actuation"],
  "properties": {
    "schema": {"const": "piton.p4-assurance-policy.v1"},
    "policy_id": {"$ref": "#/$defs/identifier"},
    "requirements": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/requirement"}},
    "supported_environment_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
    "e2e_required": {"const": 25},
    "fault_runs_minimum": {"type": "integer", "minimum": 1000},
    "critical_violations_maximum": {"const": 0},
    "false_successes_maximum": {"const": 0},
    "false_releases_maximum": {"const": 0},
    "missing_referenced_blobs_maximum": {"const": 0},
    "stale_promotions_maximum": {"const": 0},
    "duplicate_effects_maximum": {"const": 0},
    "unauthorized_cross_project_maximum": {"const": 0},
    "a11y_serious_or_critical_maximum": {"const": 0},
    "offline_golden_path": {"const": true},
    "backup_restore_verified": {"const": true},
    "review_state": {"const": "needs_human_review"},
    "fabrication_release": {"const": false},
    "machine_actuation": {"const": false}
  },
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 256},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement_id", "category", "method_digest", "comparator_digest", "threshold", "environment_ids", "invalidation_conditions"],
      "properties": {
        "requirement_id": {"$ref": "#/$defs/identifier"},
        "category": {"enum": ["accessibility", "reliability", "platform"]},
        "method_digest": {"$ref": "#/$defs/digest"},
        "comparator_digest": {"$ref": "#/$defs/digest"},
        "threshold": {"type": "object", "minProperties": 1},
        "environment_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/identifier"}},
        "invalidation_conditions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
