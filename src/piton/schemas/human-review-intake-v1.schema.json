{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "piton.human-review-intake.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "intake_id", "project_id", "revision_id", "attempt_id", "evidence_closure_digest", "review_packet_digest", "review_scope", "questions", "review_state", "fabrication_release", "machine_actuation"],
  "properties": {
    "schema": {"const": "piton.human-review-intake.v1"},
    "intake_id": {"$ref": "#/$defs/identifier"},
    "project_id": {"$ref": "#/$defs/identifier"},
    "revision_id": {"type": "string", "pattern": "^rev_[0-9a-f]{64}$"},
    "attempt_id": {"$ref": "#/$defs/identifier"},
    "evidence_closure_digest": {"$ref": "#/$defs/digest"},
    "review_packet_digest": {"$ref": "#/$defs/digest"},
    "review_scope": {"$ref": "#/$defs/review_statements"},
    "questions": {"$ref": "#/$defs/review_statements"},
    "review_state": {"const": "needs_human_review"},
    "fabrication_release": {"const": false},
    "machine_actuation": {"const": false}
  },
  "anyOf": [
    {"properties": {"review_scope": {"minItems": 1}}},
    {"properties": {"questions": {"minItems": 1}}}
  ],
  "$defs": {
    "identifier": {"type": "string", "minLength": 1, "maxLength": 256},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "review_statements": {
      "type": "array",
      "maxItems": 16,
      "items": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": ".*\\S.*"}
    }
  }
}
